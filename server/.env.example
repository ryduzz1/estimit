NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://estimit:replace-me@db:5432/estimit
POSTGRES_PASSWORD=replace-with-a-long-random-value
ESTIMIT_API_TOKEN=replace-with-a-long-random-value
ESTIMIT_BIND_ADDRESS=127.0.0.1
ALLOW_INSTALLATION_REGISTRATION=true
TRUST_TAILSCALE_IDENTITY=false
TRUST_PROXY=true

# Leave blank to use deterministic preview identification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# First recommended marketplace integration: eBay Browse (active listings).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional category provider for games, consoles, and trading cards.
PRICECHARTING_TOKEN=
